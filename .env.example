# Sambungan MySQL (format: mysql://PENGGUNA:KATA_LALUAN@HOS:PORT/NAMA_DB)
DATABASE_URL="mysql://root:rootpass@localhost:3306/eresident"

# URL awam aplikasi (digunakan untuk pautan pengaktifan & reset kata laluan)
APP_URL="http://localhost:3000"

# Tempoh sesi log masuk (jam)
SESSION_TTL_HOURS="8"

# Domain tambahan yang dibenarkan untuk Server Actions (dipisah koma), contoh untuk Codespaces/proxy:
# ALLOWED_ORIGINS="nama-codespace-3000.app.github.dev"
ALLOWED_ORIGINS=""

# Papar senarai akaun demo di halaman log masuk dalam production (JANGAN aktifkan untuk sistem sebenar)
# SHOW_DEMO_LOGINS="1"
